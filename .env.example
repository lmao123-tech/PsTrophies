# Copy to .env and fill in for local dev. Never commit the real .env.

# SQLite db file path. Relative paths resolve from wherever you run `node`
# from (the repo root, normally) — default below matches that.
DATABASE_PATH="./db/dev.db"

# Symmetric key used to encrypt stored PSN tokens at rest (generate with e.g. `openssl rand -hex 32`)
TOKEN_ENCRYPTION_KEY=""

# https://platprices.com/developers.php - free tier is fine to start (1,000 req/mo)
PLATPRICES_API_KEY=""

PORT=3000

# One-time session credential from YOUR OWN PSN login. Treat this exactly
# like a password — never commit it, never paste it into chat/Slack/an
# issue. It goes in your local .env only.
#   1. Log into playstation.com in a browser
#   2. Visit https://ca.account.sony.com/api/v1/ssocookie
#   3. Copy the "npsso" value from the JSON response
# Expires after ~60 days of inactivity — get a fresh one if the POC script
# fails with a 401/403.
PSN_NPSSO=""
